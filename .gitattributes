# Normaliza finales de línea a LF en el repositorio
* text=auto eol=lf

# Scripts que deben conservar su formato
/backend/mvnw text eol=lf
*.sh          text eol=lf
*.cmd         text eol=crlf
*.bat         text eol=crlf

# Binarios
*.jar  binary
*.png  binary
*.jpg  binary
*.ico  binary
*.zip  binary
